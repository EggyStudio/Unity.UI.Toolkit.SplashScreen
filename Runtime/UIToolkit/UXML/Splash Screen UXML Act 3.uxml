        <engine:VisualElement name="TopLeftLogo" class="SmallLogo"/>
        <engine:GroupBox>
            <engine:GroupBox>
                <engine:VisualElement name="Logo1" class="SmallLogo"/>
                <engine:VisualElement name="Logo2" class="SmallLogo"/>
